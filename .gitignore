# ============================================================
# 民俗节气 App —— Git 忽略规则
# 原则：源码 / 构建脚本 / 文档进库；
#       构建产物、本机配置、密钥、工具产生的临时文件不进库。
# ============================================================

# ---------- Gradle / Android 构建产物 ----------
.gradle/
build/
app/build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
*.hprof
.kotlin/

# ---------- 本机配置 ----------
local.properties
.env
.env.*
!.env.example
*.properties.bak

# ---------- 签名与密钥（严禁提交） ----------
*.jks
*.keystore
*.p12
key.properties
*.pem
*.p8

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
.settings/
.project
.classpath
*.iml
*.iws
*.ipr
*.swp
*~

# ---------- Python（backend 服务） ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- AI / 智能体工具的工作目录 ----------
# 会话记忆、临时脚本、中间产物，属于个人本机数据，不进版本库
.workbuddy/
.codebuddy/
.claude/
.cursor/
.aider*
*.genie

# ---------- 日志与临时文件 ----------
*.log
logs/
*.tmp
*.temp
*.bak
*.orig
*.rej
~$*
.tmp/

# ---------- 系统文件 ----------
